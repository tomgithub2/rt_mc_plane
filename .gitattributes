# 统一换行与文本处理，避免 Windows 提交 CRLF 造成 diff 噪音
* text=auto eol=lf

# Windows 下这些要保留 CRLF（双击运行）
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 这些是二进制，别做文本转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.gz binary
*.zip binary
*.db binary

# 生成物不计入语言统计
docs/evidence/*.log linguist-generated=true
